#!/bin/bash
# Exec wrapper for the ComfyUI server. Runs engines_launch.py with the user-side venv
# (~/.unsloth/engines/comfyui), which reads engines.toml and execs `python src/main.py`.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENGINES_HOME="${UNSLOTH_ENGINES_HOME:-$HOME/.unsloth/engines}"
# shellcheck source=engines-common.sh
. "$HERE/engines-common.sh"
PY="$ENGINES_HOME/comfyui/bin/python"
# launchd cannot expand "~" in StandardOutPath, so the helper logs here instead.
# A terminal run keeps its own stdout (and skips the failure backoff sleep).
LOG_DIR="${UNSLOTH_ENGINES_LOG_DIR:-$HOME/Library/Logs/Unsloth/engines}"
if [ -t 1 ]; then
  export ENGINES_FAIL_NO_SLEEP=1
else
  mkdir -p "$LOG_DIR"
  engines_rotate_log "$LOG_DIR/comfyui.log"
  exec >>"$LOG_DIR/comfyui.log" 2>&1
fi
[ -x "$PY" ] || engines_fail comfyui "venv missing: $PY (run studio/scripts/build-engines-mac.sh)"
exec "$PY" "$HERE/engines_launch.py" comfyui "$@"
