#!/bin/bash
# Exec wrapper for the ds4 on-demand launcher. Reads engines.toml via the
# user-side venv (~/.unsloth/engines/ds4-ondemand) and execs ds4_ondemand.py.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENGINES_HOME="${UNSLOTH_ENGINES_HOME:-$HOME/.unsloth/engines}"
PY="$ENGINES_HOME/ds4-ondemand/bin/python"
[ -x "$PY" ] || { echo "ds4-ondemand-launch: venv missing: $PY (run studio/scripts/build-engines-mac.sh)" >&2; exit 78; }
# launchd cannot expand "~" in StandardOutPath, so the helper logs here instead.
# A terminal run keeps its own stdout.
LOG_DIR="${UNSLOTH_ENGINES_LOG_DIR:-$HOME/Library/Logs/Unsloth/engines}"
if [ ! -t 1 ]; then
  mkdir -p "$LOG_DIR"
  exec >>"$LOG_DIR/ds4-launcher.log" 2>&1
fi
exec "$PY" "$HERE/engines_launch.py" ds4 "$@"
