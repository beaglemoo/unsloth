#!/bin/bash
# A launchctl that supervises fake_engine.py processes. State: $FAKE_LC (pid files, calls.log).
# Needs FAKE_LC, FAKE_HOME, FAKE_OMLX_PORT, FAKE_PY. FAKE_BOOTOUT_FAIL=<label suffix,
# FAKE_BOOTOUT_FAIL makes a selected helper bootout fail without stopping it.
# Like macOS for a helper bundled for SMAppService, `bootstrap` always fails ("Bootstrap failed: 5")
# and `kickstart` fails (launchd has no such label); the scripts must never depend on either. Starting
# the helpers is fake-unsloth-studio's job (`--engine-helpers register`). A bootout stops the job but
# leaves the SMAppService registration (registered.<label>) alone.
echo "launchctl $*" >>"$FAKE_LC/calls.log"
label_of() { basename "${1%.plist}"; }
alive() { [ -f "$FAKE_LC/$1.pid" ] && kill -0 "$(cat "$FAKE_LC/$1.pid")" 2>/dev/null; }
case "$1" in
  print) alive "$(label_of "$2")" ;;
  bootout)
    label="$(label_of "$2")"
    alive "$label" || exit 3
    [ -z "${FAKE_BOOTOUT_FAIL:-}" ] || [ "${label##*.}" != "$FAKE_BOOTOUT_FAIL" ] || exit 5
    pid="$(cat "$FAKE_LC/$label.pid")"
    kill "$pid"
    n=0
    while kill -0 "$pid" 2>/dev/null; do
      n=$((n + 1))
      [ "$n" -lt 40 ] || kill -KILL "$pid" 2>/dev/null || true
      sleep 0.05
    done
    rm -f "$FAKE_LC/$label.pid" ;;
  bootstrap) exit 5 ;;
  kickstart) exit 113 ;;
  *) exit 64 ;;
esac
